<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base Leanback Theme -->
    <style name="Theme.Batman" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/midnight_bg</item>
        <item name="android:colorBackground">@color/midnight_bg</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
    
    <style name="Theme.Batman.Dialog" parent="android:Theme.Material.Dialog.NoActionBar">
        <item name="android:windowBackground">@color/transparent</item>
        <item name="android:colorBackground">@color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
