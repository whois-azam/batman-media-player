<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_error_offline"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/midnight_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp"
    android:visibility="gone">

    <!-- Bat Logo mark -->
    <ImageView
        android:id="@+id/error_bat_logo"
        android:layout_width="96dp"
        android:layout_height="60dp"
        android:contentDescription="@string/app_name"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_bat_logo" />

    <TextView
        android:id="@+id/error_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="sans-serif-medium"
        android:text="@string/error_loading_title"
        android:textColor="@color/text_primary"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/error_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:maxWidth="480dp"
        android:text="@string/error_loading_desc"
        android:textColor="@color/text_secondary"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_error_retry"
            android:layout_width="160dp"
            android:layout_height="44dp"
            android:background="@drawable/btn_settings_item_selector"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:text="@string/action_retry"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btn_error_settings"
            android:layout_width="160dp"
            android:layout_height="44dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/btn_settings_item_selector"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:text="@string/action_settings"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />
    </LinearLayout>

</LinearLayout>
