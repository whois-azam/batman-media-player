<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#10141A">

    <!-- ================= 1. ANDROID TV TOP HEADER ================= -->
    <RelativeLayout
        android:id="@+id/tv_header_container"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentTop="true"
        android:background="#181E26"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:visibility="gone">

        <!-- Left: Logo & Branding -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentStart="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="24dp"
                android:contentDescription="Batman"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_bat_logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="sans-serif-medium"
                android:text="Batman"
                android:textColor="#F0F2F5"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Universal Player"
                android:textColor="#9AA4B2"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Right: TV Actions & Clock -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentEnd="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/tv_btn_reload"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/btn_header_selector"
                android:contentDescription="Reload"
                android:focusable="true"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_refresh" />

            <ImageButton
                android:id="@+id/tv_btn_home"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/btn_header_selector"
                android:contentDescription="Home"
                android:focusable="true"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_home" />

            <ImageButton
                android:id="@+id/tv_btn_bookmarks"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/btn_header_selector"
                android:contentDescription="Bookmarks"
                android:focusable="true"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_settings" />

            <ImageButton
                android:id="@+id/tv_btn_settings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/btn_header_selector"
                android:contentDescription="Settings"
                android:focusable="true"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_settings" />

            <com.batman.player.views.BatClockView
                android:id="@+id/tv_header_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:gravity="center_vertical" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Web Progress Bar -->
    <ProgressBar
        android:id="@+id/web_progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_alignParentTop="true"
        android:indeterminate="false"
        android:max="100"
        android:visibility="gone" />

    <!-- ================= 3. BOTTOM NAVIGATION BAR (PHONE) ================= -->
    <LinearLayout
        android:id="@+id/bottom_nav_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentBottom="true"
        android:background="#181E26"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="visible">

        <LinearLayout
            android:id="@+id/tab_browser"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/tab_browser_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_home" />

            <TextView
                android:id="@+id/tab_browser_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Player"
                android:textColor="#3D9BE9"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_bookmarks"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/tab_bookmarks_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_refresh" />

            <TextView
                android:id="@+id/tab_bookmarks_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Bookmarks"
                android:textColor="#9AA4B2"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_profile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <com.batman.player.views.AvatarView
                android:id="@+id/tab_profile_avatar"
                android:layout_width="24dp"
                android:layout_height="24dp" />

            <TextView
                android:id="@+id/tab_profile_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Profile"
                android:textColor="#9AA4B2"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_settings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/tab_settings_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_settings" />

            <TextView
                android:id="@+id/tab_settings_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Settings"
                android:textColor="#9AA4B2"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ================= 4. MAIN WORKSPACE / CONTENT AREA ================= -->
    <LinearLayout
        android:id="@+id/main_content_area"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottom_nav_bar"
        android:layout_below="@+id/tv_header_container"
        android:orientation="horizontal">

        <!-- Navigation Rail (Tablets & Desktop) -->
        <LinearLayout
            android:id="@+id/nav_rail_container"
            android:layout_width="72dp"
            android:layout_height="match_parent"
            android:background="#181E26"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="16dp"
            android:visibility="gone">

            <com.batman.player.views.AvatarView
                android:id="@+id/rail_profile_avatar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginBottom="24dp"
                android:clickable="true"
                android:focusable="true" />

            <ImageButton
                android:id="@+id/rail_btn_browser"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginBottom="16dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Browser"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_home" />

            <ImageButton
                android:id="@+id/rail_btn_bookmarks"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginBottom="16dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Bookmarks"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_refresh" />

            <ImageButton
                android:id="@+id/rail_btn_settings"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Settings"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_settings" />
        </LinearLayout>

        <!-- Viewport Container (holds Web, Native Player, CustomView) -->
        <FrameLayout
            android:id="@+id/viewport_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <!-- WebView -->
            <WebView
                android:id="@+id/batman_webview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#10141A" />

            <!-- Direct Native Media Player -->
            <com.batman.player.media.NativeMediaPlayerView
                android:id="@+id/native_player_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <!-- HTML5 Fullscreen View Container -->
            <FrameLayout
                android:id="@+id/custom_view_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#000000"
                android:visibility="gone" />

            <!-- Offline / Connection Error Overlay -->
            <include
                android:id="@+id/include_error"
                layout="@layout/view_error_offline"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <!-- Non-Video Notification Banner -->
            <LinearLayout
                android:id="@+id/non_video_toast_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="16dp"
                android:background="#D9161E29"
                android:elevation="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingEnd="16dp"
                android:paddingBottom="10dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="Info"
                    android:src="@drawable/ic_settings" />

                <TextView
                    android:id="@+id/non_video_toast_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Video content not detected. App is optimized for video playback."
                    android:textColor="#E0E6ED"
                    android:textSize="13sp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

</RelativeLayout>
